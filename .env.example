# Copia este archivo a .env y ajusta los valores antes de levantar docker-compose

DB_USER=cards
DB_PASSWORD=cambia-esta-contraseña
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=30d

# Origen desde el que se sirve el frontend (para CORS del backend)
CORS_ORIGIN=http://localhost:8080

# Puerto en el host donde quedará expuesta la aplicación
APP_PORT=8080

# Marca "Secure" en la cookie de sesión (el navegador solo la envía por HTTPS).
# Déjalo VACÍO para decidirlo automáticamente en cada petición: las servidas por
# HTTPS a través de un proxy inverso la llevan, las de HTTP en la LAN no.
# Ponlo a true o false solo si quieres forzar un valor fijo.
COOKIE_SECURE=

# Usuario administrador que se crea automáticamente al arrancar (si no existe ya).
# Ambas son OPCIONALES: si no las tocas, docker-compose.yml ya usa "admin" como
# usuario, y si dejas ADMIN_PASSWORD vacío, la app genera una contraseña aleatoria
# y la muestra UNA vez en los logs (`docker compose logs app`). Ponla tú aquí si
# prefieres elegirla de antemano.
ADMIN_USER=admin
ADMIN_PASSWORD=
